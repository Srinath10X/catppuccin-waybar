{
  /*
    INFO
    - All icons used are Nerd Font Material Design icons (nf-md-*)
  */

  /* ----- Left Modules ----- */

	/* --- Workspaces --- */
	/* - Group - */
	"group/workspaces" : {
	    "modules": [
			"hyprland/workspaces#special",
			"hyprland/workspaces#normal"
		],
		"orientation": "horizontal"
	},
	/* - Special - */
	"hyprland/workspaces#special": { // Shows special workspaces only
	    "all-outputs": true,
	    "hide-empty": true,
		"show-special": true,
		"ignore-workspaces": ["\\d+"], // Ignore unnamed (number only) workspaces
		"tooltip": false,
		"format": "{icon}",
		"format-icons": {
            "default":  "󰘔",
            "terminal": "󰆍"
		}
	},
	/* - Normal - */
	"hyprland/workspaces#normal": { // Shows normal workspaces
	    "move-to-monitor": true,
	    "disable-scroll": true,
	    "on-click": "activate",
		"all-outputs": true,
	    "tooltip": false,
	    "format": "{icon}",
        "format-icons": {
		    "default":  "",
		    "active":   "",
		    "urgent":   "󰗖",
		    "visible":  "󰻃"
        }
    },

  /* --- Window --- */
	"hyprland/window": {
	    "separate-outputs": true,
        "format": "{title}",
        "icon": true,
        "icon-size": 20
   },

  /* --- Tray --- */
	"tray": {
		"icon-size": 16,
		"spacing": 12,
		"cursor": true,
		"expand": false
	},

	/* ----- Center Modules ----- */

	/* --- Notfications --- */
	"custom/swaync": {
	    "exec-if": "which swaync-client",
	    "exec": "swaync-client --subscribe-waybar",
		"return-type": "json",
		"on-click": "swaync-client --toggle-panel --skip-wait",
	    "format": "{icon}",
		"min-length": 3,
		"justify": "center",
		"format-icons": {
            "notification":               "󱅫",
            "none":                       "󰂜",
            "dnd-notification":           "󰂠",
            "dnd-none":                   "󰪓",
            "inhibited-notification":     "󰂛",
            "inhibited-none":             "󰪑",
            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none":         "󰪑"
        },
        "tooltip": true
	},

	/* --- Clock --- */
	/* - Group - */
	"group/clock" : {
	    "modules": [
			"clock#date",
			"clock#time"
		],
		"orientation": "horizontal"
	},
	/* - Date - */
	"clock#date": {
	    "format": "󰃭 {0:%Y-%m-%d}",
		"tooltip-format": "<tt>{calendar}</tt>",
		"calendar": {
			"mode": "month",
			"mode-mon-col": 3,
			"on-scroll": 1,
			"on-click-right": "mode",
			"format": {
  			    "months":   "<span color='#b8c0e0'><b>{}</b></span>", // Macchiato Subtext 1
  			    "weekdays": "<span color='#8aadf4'><b>{}</b></span>", // Macchiato Blue
  			    "today":    "<span color='#ed8796'><b>{}</b></span>"  // Macchiato Red
			}
		}
	},
	/* - Time - */
	"clock#time": {
	    "interval": 1,
		"timezones": [
		    "",   // Represents system's TZ
			"UTC"
		],
		"format": " {0:%H:%M:%S-%Z}",
		"tooltip-format": "{tz_list}",
		"timezone-tooltip-format": "{0:%Z %H:%M %z}"
	},

	/* ----- Right Modules ----- */

	/* --- Idle Inhibitor --- */
	"idle_inhibitor": {
		"format": "{icon}",
		"min-length": 2,
		"tooltip-format-activated":   "<b>Idle Inhibitor</b>: Activated",
		"tooltip-format-deactivated": "<b>Idle Inhibitor</b>: Deactivated",
		"format-icons": {
			"activated":    "󰅶",
			"deactivated":  "󰛊"
		}
	},

	/* --- Brightness --- */
	"backlight": {
    "on-scroll-up":   "brightnessctl set 1%+",
    "on-scroll-down": "brightnessctl set 1%-",
    "format": "{icon}",
    "min-length": 2,
    "tooltip-format": "{icon} {percent}%",
		"format-icons": ["󰃚", "󰃛", "󰃜", "󰃝", "󰃞", "󰃟", "󰃠"]
	},

	/* --- Volume --- */
	/* - Group - */
	"group/volume": {
	    "modules": [
			"pulseaudio#output",
			"pulseaudio#input"
		],
		"orientation": "horizontal",
		"drawer": {
			"transition-left-to-right": false
		}
	},
	/* - Input - */
	"pulseaudio#input": {
	    "target": "source",
	    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
	    "format": "{format_source}",
        "format-source":        "󰍬 {volume}%",
        "format-source-muted":  "󰍭 {volume}%",
        "tooltip-format": "{source_desc}"
	},
	/* - Output - */
	"pulseaudio#output": {
	    "target": "sink",
		"on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
		"format":       "{icon} {volume}%",
		"format-muted": "{icon} {volume}%",
		"tooltip-format": "{desc}",
		"format-icons": {
		    "default": ["󰕿", "󰖀", "󰕾"],
			"default-muted":    "󰝟",
			"car":              "󰄋",
			"car-muted":        "󰸜",
			"hdmi":             "󰐯",
			"hdmi-muted":       "󱠍",
			"headphone":        "󰋋",
			"headphone-muted":  "󰟎",
			"headset":          "󰋎",
			"headset-muted":    "󰋐",
			"phone":            "󰄜",
			"phone-muted":      "󰥐",
			"speaker":          "󰓃",
			"speaker-muted":    "󰓄"
		}
	},

	/* --- Bluetooth --- */
	"bluetooth": {
	    "on-click": "blueman-manager",
	    "format": "{icon}",
	    "tooltip-format":               "Bluetooth {status}\n<b>Controller</b> {controller_alias}\n 󰘚 {controller_address} ({controller_address_type})",
  	    "tooltip-format-connected":     "<b>Controller</b> {controller_alias}\n 󰘚 {controller_address}\n<b>Connected Devices</b> ({num_connections})\n{device_enumerate}",
        "tooltip-format-disabled":      "Bluetooth disabled",
        "tooltip-format-no-controller": "No Bluetooth controller found",
        "tooltip-format-off":           "Bluetooth off",
        "tooltip-format-enumerate-connected":         " 󰂱 {device_alias}\n   󰘚 {device_address}{icon}",
        "tooltip-format-enumerate-connected-battery": " 󰂱 {device_alias} [{icon} {device_battery_percentage}%]\n   󰘚 {device_address}",
		"format-icons": {
			"default": ["󰤾", "󰤿", "󰥀", "󰥁", "󰥂", "󰥃", "󰥄", "󰥅", "󰥆", "󰥈"],
  			"connected":      "󰂱",
 			"disabled":       "󰂲",
      		"no-controller":  "󰂲!",
		  	"on":             "󰂰",
 			"off":            "󰂲"
		}
	},

	/* --- Network --- */
	"network": {
  	    "format":               "{icon} {essid}",
        "format-alt":           "{icon} 󰳘 {bandwidthUpBytes} 󰱦 {bandwidthDownBytes}",
        "format-disabled":      "{icon}",
        "format-disconnected":  "{icon}",
        "format-ethernet":      "{icon} {ifname}",
        "format-linked":        "{icon} {ifname}",
        "format-wifi":          "{icon} {essid}",
        "min-length": 2,
        "tooltip-format-disabled":      "Network Disabled",
		"tooltip-format-disconnected":  "Network Disconnected",
		"tooltip-format-ethernet":      "<b>Ethernet</b> {bssid}\n 󱦂 {gwaddr}\n 󰳘 {bandwidthUpBytes}\t󰱦 {bandwidthDownBytes}\n<b>Interface</b> {ifname}\n 󰲐 {ipaddr}\t󱡔 {netmask}",
		"tooltip-format-linked":        "<b>Interface</b> {ifname}",
		"tooltip-format-wifi":          "<b>Wi-Fi</b> {essid}\n 󱦂 {gwaddr}\t󰘚 {bssid}\n 󱄙 {signaldBm} dBm\t󰥛 {frequency} GHz\t󰒢 {signalStrength}%\n 󱚻 {bandwidthTotalBits}\t󰶡 {bandwidthDownBits}\t󰶣 {bandwidthUpBits}\n<b>Interface</b> {ifname}\n 󰲐 {ipaddr}\t󱡔 {netmask}",
        "format-icons": {
		  	"default":      "󰛳",
			"disabled":     "󰅛",
			"disconnected": "󰲛",
			"ethernet":     "󰈀",
			"linked":       "󰌷",
			"wifi": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"]
		}
	},

	/* --- Battery --- */
	"battery": {
		"interval": 20,
  		"states": {
  	  		"full": 100,
  			"warning": 25,
  			"critical": 15,
      		"dead": 5
  	    },
        "events": {
            "on-plugged-full":          "notify-send -u low -i battery-level-100-plugged-in-symbolic 'Battery Full' 'Battery at 100%'",
            "on-discharging-warning":   "notify-send -u normal -i battery-level-20-symbolic 'Battery Low' 'Battery at 25%' ",
            "on-discharging-critical":  "notify-send -u critical -i battery-level-10-symbolic 'Battery Critical' 'Battery at 15%'",
            "on-discharging-dead":      "notify-send -u critical -i battery-level-0-symbolic 'Battery Empty' 'Battery at 5%'"
        },
		"format": "{icon} {capacity}%",
		"min-length": 6,
		"tooltip-format":               "󱈑 {health}%\n󱠴 {cycles}",
		"tooltip-format-charging":      "Charging\n󱐋 {power}W\n󱧥 {time}\n󱈑 {health}%\n󱠴 {cycles}",
		"tooltip-format-discharging":   "Discharging\n󱐋 {power}W\n󱧦 {time}\n󱈑 {health}%\n󱠴 {cycles}",
		"tooltip-format-not-charging":  "Not Charging\n󱈑 {health}%\n󱠴 {cycles}",
		"tooltip-format-plugged":       "Plugged\n󱐋 {power}W\n󱈑 {health}%\n󱠴 {cycles}",
		"format-time": "{H}h {m}m",
		"format-icons": {
		  	"default":  ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
			"charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
			"discharging-critical": "󱃍",
			"not-charging": "󱐥",
			"plugged": "󰚥"
		}
	}
}

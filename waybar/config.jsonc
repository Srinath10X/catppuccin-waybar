[
  {
    "name": "waybar-main",

    /* ===== General ===== */

    "output": "eDP-1",

    "reload-style-on-change": true,

  	/* --- Size --- */
  	"height": 42,
    "width": "100%",

  	/* --- Position --- */
    "layer": "top",
    "position": "top",

  	/* --- Margin --- */
    "margin-right":   5,
    "margin-left":    5,
  	"margin-top":     5,
  	"margin-bottom":  0,


  	/* ===== Modules ===== */

  	"include": [
  	  "modules.jsonc"
  	],

  	/* ----- Layout ----- */
    "modules-left":   ["group/workspaces", "hyprland/window", "tray"],
    "modules-center": ["custom/swaync", "group/clock"],
    "modules-right":  ["idle_inhibitor", "backlight", "group/volume", "bluetooth", "network", "battery"]

  },
  {
    "name": "waybar-other",

    /* ===== General ===== */

    "output": "!eDP-1",

    "reload-style-on-change": true,

  	/* --- Size --- */
  	"height": 42,
    "width": "100%",

  	/* --- Position --- */
    "layer": "top",
    "position": "top",

  	/* --- Margin --- */
    "margin-right":   5,
    "margin-left":    5,
  	"margin-top":     5,
  	"margin-bottom":  0,


  	/* ===== Modules ===== */

  	"include": [
  	  "modules.jsonc"
  	],

  	/* ----- Layout ----- */
    "modules-left":   ["group/workspaces", "hyprland/window", "tray"],
    "modules-center": ["custom/swaync", "group/clock"],
    "modules-right":  ["idle_inhibitor", "group/volume", "bluetooth", "network", "battery"]

  }
]
